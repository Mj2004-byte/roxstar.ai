# ==================================================
# ROXSTAR AI VOICE ROOM ASSISTANT - ENVIRONMENT CONFIG
# ==================================================

# --------------------------------------------------
# LiveKit Real-Time Server Configuration
# --------------------------------------------------
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Frontend Public Environment Variables
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# --------------------------------------------------
# OpenAI API Configuration (LLM Provider)
# --------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o

# --------------------------------------------------
# STT (Speech-To-Text) Provider Configuration
# Supported: deepgram, whisper, mock
# --------------------------------------------------
STT_PROVIDER=deepgram
STT_API_KEY=your_deepgram_api_key_here

# --------------------------------------------------
# TTS (Text-To-Speech) Provider Configuration
# Supported: elevenlabs, openai, mock
# --------------------------------------------------
TTS_PROVIDER=elevenlabs
TTS_API_KEY=your_elevenlabs_api_key_here

# Voice IDs for AI Personas
# Male voice for "Roxstar AI Dost"
TTS_MALE_VOICE_ID=male_indian_voice_id_dost
# Female voice for "Roxstar AI Sathi"
TTS_FEMALE_VOICE_ID=female_indian_voice_id_sathi

# --------------------------------------------------
# Backend Server Host & Port
# --------------------------------------------------
HOST=0.0.0.0
PORT=8000
